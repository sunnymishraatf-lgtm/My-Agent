# NEUTRON provider configuration.
#
# Copy this file to `.env` (in the directory you run `neutron` from, or your
# home directory) and fill in the values. The CLI loads `.env` automatically
# on startup — no shell exports needed, and it works on Windows CMD too.
#
# Naming convention (same for every provider):
#   <PREFIX>_API_KEY    your API key (never commit this file)
#   <PREFIX>_BASE_URL   override the API endpoint (optional when a default exists)
#   <PREFIX>_MODELS     comma-separated model ids to use (optional)
#
# Real environment variables always win over values in `.env`.

# --- AgentRouter (recommended) ---------------------------------------------
# Get a key at https://agentrouter.org
AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODELS=claude-opus-5,claude-opus-4-8,deepseek-v4-flash,gpt-5.6-sol,gpt-6-astra

# --- OpenAI -----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-4-1,claude-sonnet-4-5

# --- OpenRouter ---------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=

# --- Groq ----------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile

# --- DeepSeek -------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-chat

# --- Google Gemini ---------------------------------------------------------------
# GOOGLE_API_KEY=
# GOOGLE_MODELS=gemini-2.5-flash

# --- Ollama (local, no key needed) -------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODELS=

# --- Any custom OpenAI-compatible endpoint ------------------------------------------
# ANY_BASE_URL=http://localhost:3001/v1
# ANY_API_KEY=
# ANY_MODELS=
